{
    "name":  "wa-tg-bridge-assistant",
    "version":  "1.0.0",
    "description":  "Bridge WhatsApp(Group)-\u003eTelegram com assistente via comandos do Telegram para bindar chat e grupo. Inclui modo FAKE.",
    "main":  "electron.js",
    "scripts":  {
                    "start":  "node index.js",
                    "fake":  "cross-env TEST_FAKE_WPP=1 node index.js",
                    "build:win":  "pkg -t node18-win-x64 --out-path dist index.js && copy .env dist\\.env",
                    "build:all":  "pkg -t node18-win-x64,node18-linux-x64,node18-macos-x64 --out-path dist index.js",
                    "start:electron":  "cross-env AUTO_OPEN=0 electron electron.js",
                    "build:electron:win":  "cross-env AUTO_OPEN=0 electron-builder --win --x64",
    "pack:electron:win":  "cross-env AUTO_OPEN=0 node scripts/pack-electron.js"
                },
    "dependencies":  {
                         "dotenv":  "^16.4.5",
                         "node-telegram-bot-api":  "^0.66.0",
                         "qrcode-terminal":  "^0.12.0",
                         "whatsapp-web.js":  "^1.26.0",
                         "cross-env":  "^7.0.3",
                         "express":  "^4.19.2",
                         "qrcode":  "^1.5.4"
                     },
    "devDependencies":  {
                            "pkg":  "^5.8.1",
                            "electron":  "^31.3.0",
                            "electron-builder":  "^24.13.3",
                            "electron-packager": "^17.1.2"
                        },
    "pkg":  {
                "assets":  [
                               "public/**/*",
                               ".env.example",
                               "README.md"
                           ]
            },
    "build":  {
                  "appId":  "com.wa.tg.assistant",
                  "productName":  "WA TG Assistant",
                  "files":  [
                                "**/*",
                                "!dist/**",
                                "!node_modules/.cache/**"
                            ],
                  "extraResources":  [
                                         ".env"
                                     ],
                  "win":  {
                              "target":  [
                                             "nsis"
                                         ],
                              "artifactName":  "${productName}-${version}-win.${ext}"
                          }
              }
}
